# Copy this file to .env and fill in your key.
# Get a key at https://console.anthropic.com

ANTHROPIC_API_KEY=

# Optional: override the model. Default is claude-opus-5.
# For high volume, claude-sonnet-5 is cheaper and still excellent.
# MODEL=claude-sonnet-5

# Optional: change the port (default 3000)
# PORT=3000
